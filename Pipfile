[[source]]
url = "https://mentor-forge-560167829275.d.codeartifact.us-east-1.amazonaws.com/pypi/mentorhub-pypi/simple/"
verify_ssl = true
name = "codeartifact"

[packages]
flask = "*"
pymongo = "*"
pyjwt = "*"
# Must use codeartifact index: PyPI package "api-utils" is unrelated; wrong index breaks Config/auth.
api-utils = {version = "==0.2.1", index = "codeartifact"}

[dev-packages]
pytest = "*"
pytest-cov = "*"
black = "*"
setuptools = "*"
build = "*"
twine = "*"
requests = "*"

[scripts]
install = "sh scripts/pipenv-install.sh"
build = "python -m compileall -b -f -q src/"
dev = "sh -c 'export JWT_SECRET=\"${JWT_SECRET:-local-dev-jwt-secret-fixed}\"; export JWT_ISSUER=\"${JWT_ISSUER:-dev-idp}\"; export JWT_AUDIENCE=\"${JWT_AUDIENCE:-dev-api}\"; export JWT_ALGORITHM=\"${JWT_ALGORITHM:-HS256}\"; PYTHONPATH=. python src/server.py'"
test = "sh -c 'PYTHONPATH=. pytest test/ -v -m \"not e2e\"'"
e2e = "sh -c 'export JWT_SECRET=\"${JWT_SECRET:-local-dev-jwt-secret-fixed}\"; export JWT_ISSUER=\"${JWT_ISSUER:-dev-idp}\"; export JWT_AUDIENCE=\"${JWT_AUDIENCE:-dev-api}\"; export JWT_ALGORITHM=\"${JWT_ALGORITHM:-HS256}\"; PYTHONPATH=. pytest test/ -m e2e -v'"
coverage = "sh -c 'PYTHONPATH=. pytest test/ -v -m \"not e2e\" --cov=src --cov-report=term-missing --cov-report=html'"
lint = "black --check src test"
format = "black src test"
container = "sh scripts/docker-build.sh"
push = "sh -c 'docker push ghcr.io/mentor-forge/mentorhub_mentor_api:latest'"
build-publish = "sh -c 'pipenv run install && pipenv run container && pipenv run push'"
build-package = "sh -c 'pipenv run install && pipenv run container'"
publish-package = "sh -c 'pipenv run push'"
delete-package = "sh -c 'gh api -X DELETE /orgs/mentor-forge/packages/container/mentorhub_mentor_api'"
db = "sh -c 'mh down && mh up mongodb'"
api = "sh -c 'mh down && mh up mentor-api'"
service = "sh -c 'mh down && mh up mentor'"

[requires]
python_version = "3.12"
